# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.18.0 --activate

COPY pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/core/package.json ./packages/core/
COPY packages/backfill/package.json ./packages/backfill/
COPY packages/webhook/package.json ./packages/webhook/

RUN pnpm install --frozen-lockfile=false

COPY packages/core ./packages/core
COPY packages/backfill ./packages/backfill

RUN pnpm --filter @stripe-to-amplitude/core build && \
    pnpm --filter @stripe-to-amplitude/backfill build

# ----------------- Runtime image -----------------
FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

RUN corepack enable && corepack prepare pnpm@10.18.0 --activate && \
    addgroup -S app && adduser -S app -G app

COPY --from=builder --chown=app:app /app/pnpm-workspace.yaml /app/package.json ./
COPY --from=builder --chown=app:app /app/packages/core/package.json ./packages/core/
COPY --from=builder --chown=app:app /app/packages/core/dist ./packages/core/dist
COPY --from=builder --chown=app:app /app/packages/backfill/package.json ./packages/backfill/
COPY --from=builder --chown=app:app /app/packages/backfill/dist ./packages/backfill/dist

RUN pnpm install --prod --frozen-lockfile=false

USER app
ENV BACKFILL_STATE_DIR=/state
VOLUME ["/state"]
CMD ["node", "packages/backfill/dist/index.js"]
